PORT=3002

# DynamoDB (NoSQL). Local: DynamoDB Local via docker compose.
AWS_REGION=us-east-1
DYNAMODB_TABLE=execution
DYNAMODB_ENDPOINT=http://localhost:8000
# Required by the SDK even for DynamoDB Local
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# Messaging (empty = log only / no consumer)
AWS_ENDPOINT_URL=
EXECUTION_SNS_TOPIC_ARN=
EXECUTION_SQS_QUEUE_URL=

# Same HS256 secret as os-service / auth lambda (ADR-001). Empty = every
# protected route returns 401.
JWT_SECRET=
